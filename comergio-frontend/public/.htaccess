<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host and legacy login path.
  RewriteCond %{HTTP_HOST} ^www\.comergio\.com$ [NC]
  RewriteRule ^(.*)$ https://comergio.com/$1 [R=301,L]
  RewriteRule ^login/?$ / [R=301,L]

  # Keep direct access to index, game audio, and uploaded assets untouched.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} ^/tourvirtualberckley/ [NC]
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} ^/game/ [NC]
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteRule ^ - [L]

  # Existing files/directories should be served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for routes like /admin, /pos, /parent/menu, etc.
  RewriteRule . /index.html [L]
</IfModule>

AddType audio/mp4 .m4a
AddType audio/aac .aac
AddType audio/mpeg .mp3
AddType audio/wav .wav
AddType audio/wave .wav

<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(?:m4a|mp3|wav|aac|ogg)$ no-gzip dont-vary
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|gif|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.m4a$">
    Header set Content-Type "audio/mp4"
    Header unset Content-Encoding
  </FilesMatch>

  <FilesMatch "\.mp3$">
    Header set Content-Type "audio/mpeg"
    Header unset Content-Encoding
  </FilesMatch>

  <FilesMatch "\.wav$">
    Header set Content-Type "audio/wav"
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>
